# Copie este arquivo para .env e preencha antes de rodar "docker compose up".
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Nome do banco e usuário do PostgreSQL (a senha NÃO fica aqui - veja abaixo)
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow

# Porta no host que aponta para o app (padrão 8000). Mude aqui se a porta
# já estiver em uso por outro projeto na sua máquina.
APP_PORT=8000

# A senha do Postgres fica num arquivo separado (Docker secret), não em variável
# de ambiente. Antes de subir o sistema, crie o arquivo:
#   mkdir -p secrets
#   python -c "import secrets; print(secrets.token_hex(24))" > secrets/postgres_password.txt
